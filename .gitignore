# ===== LaTeX build artifacts (do not commit) =====
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.nav
*.snm
*.vrb
*.bcf
*.run.xml

# Root / local build PDF only
/main.pdf

# Compiled dump directory (overwrite locally after build)
/output/

# Exported page proofs (keep .docx source if needed)
/pages/*.pdf

# ===== Keep required PDFs =====
# Official SPIE/ISIP docs
!docs/**/*.pdf
# Paper figures used by \includegraphics
!figures/**/*.pdf

# ===== OS / editor / local tooling =====
.DS_Store
Thumbs.db
*~
*.swp
.idea/
.vscode/
.claude/
*.local.json

# ===== Temp / caches =====
*.tmp
__pycache__/
*.pyc
.ipynb_checkpoints/
references.bib.bak.*
*.bib.bak.*
